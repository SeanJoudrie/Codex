 "models": {
  "subscription": {
   "label": "Monthly subscription",
   "short": "a monthly subscription",
   "recurring": true,
   "conversion": 0.03,
   "how": "Free to start; a subscription unlocks the parts people come back for.",
   "risk": "Needs a reason to come back every week, or people cancel.",
   "cut": "App stores keep 15–30% of in-app subscriptions; web payments through a processor cost about 3%."
  },
  "onetime": {
   "label": "One-time purchase",
   "short": "a one-time purchase",
   "recurring": false,
   "conversion": 0.02,
   "how": "A free trial or demo, then one payment for the full version.",
   "risk": "Every month starts at zero; you need a steady stream of new buyers.",
   "cut": "Stores keep 15–30%; itch.io lets you set its cut; Steam keeps 30%."
  },
  "iap": {
   "label": "In-app purchases",
   "short": "in-app purchases",
   "recurring": false,
   "conversion": 0.02,
   "how": "Free to play or use; people buy extras, packs or cosmetics.",
   "risk": "Pushy purchase design drives people away; keep it fair.",
   "cut": "App stores keep 15–30%."
  },
  "ads": {
   "label": "Ads",
   "short": "ads",
   "recurring": true,
   "conversion": 1.0,
   "how": "Free for everyone; ads pay per thousand views.",
   "risk": "Pays little per person, so it needs very large, regular traffic.",
   "cut": "Ad networks keep their share; you see a few dollars per thousand views at best for most audiences."
  },
  "b2b": {
   "label": "Business subscription",
   "short": "a business subscription",
   "recurring": true,
   "conversion": 0.05,
   "how": "Businesses pay monthly per location or seat after a free trial.",
   "risk": "Needs selling: demos, cold email, support. Fewer customers, each worth much more.",
   "cut": "Payment processing is about 3%."
  },
  "marketplace": {
   "label": "Commission",
   "short": "a commission on sales",
   "recurring": true,
   "conversion": 0.02,
   "how": "Free to list or browse; you take a cut of each sale or booking.",
   "risk": "You have to bring both buyers and sellers at once.",
   "cut": "You keep your commission minus about 3% processing."
  },
  "affiliate": {
   "label": "Affiliate links",
   "short": "affiliate links",
   "recurring": true,
   "conversion": 0.01,
   "how": "Recommend products people already buy and earn a small cut of each sale.",
   "risk": "Small cuts and cookies that expire; it only works at volume and with trust.",
   "cut": "Commissions are commonly a few percent of the sale."
  }
